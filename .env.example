# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_post_db?schema=public"

# JWT
JWT_SECRET="change_this_to_a_very_long_random_secret_key"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS - comma-separated list of allowed origins for admin routes
# Use * to allow all, or specify domains: http://localhost:3000,https://mysite.com
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
