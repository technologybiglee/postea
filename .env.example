# Database (Supabase Postgres — Session Pooler connection string)
# Copiar desde el dashboard del proyecto Supabase: botón "Connect" > Session pooler.
# Se recomienda usar el rol "prisma" (dedicado, no el superusuario "postgres") — ver docs/README.md.
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# JWT
JWT_SECRET="change_this_to_a_very_long_random_secret_key"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# URL pública base de la API (usada para el "server" del OpenAPI/Swagger en producción).
# En Render se puede omitir: si no se define, se usa RENDER_EXTERNAL_URL automáticamente.
API_BASE_URL=""

# CORS - comma-separated list of allowed origins for admin routes
# Use * to allow all, or specify domains: http://localhost:3000,https://mysite.com
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Super admin bootstrap - used by `npx prisma db seed` to create the first
# super admin (can create companies and view data across all tenants).
# Leave empty to skip the bootstrap.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Super Admin"
