{
  "openapi": "3.0.3",
  "info": {
    "title": "Postea",
    "description": "REST API multiempresa (multi-tenant) para blogs: posts, categorias, tags y autenticacion JWT, con endpoints publicos de lectura por empresa.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local" }
  ],
  "tags": [
    { "name": "Health", "description": "Estado del servicio" },
    { "name": "Auth", "description": "Registro e inicio de sesion" },
    { "name": "Companies", "description": "Gestion de la empresa (tenant) autenticada" },
    { "name": "Posts", "description": "CRUD de posts (requiere autenticacion)" },
    { "name": "Categories", "description": "CRUD de categorias (requiere autenticacion)" },
    { "name": "Tags", "description": "CRUD de tags (requiere autenticacion)" },
    { "name": "Public", "description": "Lectura publica de posts publicados, sin autenticacion" },
    { "name": "Admin", "description": "Solo lectura, cross-tenant. Requiere un usuario con role=super_admin" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token obtenido en POST /api/auth/login."
      }
    },
    "schemas": {
      "PostStatus": {
        "type": "string",
        "enum": ["draft", "pending", "published"]
      },
      "UserRole": {
        "type": "string",
        "enum": ["user", "super_admin"],
        "description": "'user' pertenece a una empresa (companyId no nulo). 'super_admin' no pertenece a ninguna (companyId null) y solo se crea via seed."
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string" }
        },
        "required": ["success", "error"]
      },
      "ApiMessage": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Acme Inc" },
          "slug": { "type": "string", "example": "acme-inc" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "settings": { "$ref": "#/components/schemas/CompanySettings" }
        }
      },
      "CompanySettings": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "companyId": { "type": "integer" },
          "allowedOrigins": { "type": "array", "items": { "type": "string" } },
          "defaultPostStatus": { "$ref": "#/components/schemas/PostStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "companyId": { "type": "integer", "nullable": true, "description": "null para un super_admin." },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthLoginResponseData": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "email": { "type": "string", "format": "email" },
              "name": { "type": "string" },
              "role": { "$ref": "#/components/schemas/UserRole" }
            }
          },
          "company": {
            "type": "object",
            "nullable": true,
            "description": "null cuando el usuario es un super_admin.",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "slug": { "type": "string" }
            }
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "companyId": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "companyId": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PostCategoryRef": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "PostAuthorRef": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "PublicPostAuthorRef": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "TagRef": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "cover": { "type": "string", "nullable": true },
          "body": { "type": "string" },
          "status": { "$ref": "#/components/schemas/PostStatus" },
          "companyId": { "type": "integer" },
          "categoryId": { "type": "integer" },
          "authorId": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "category": { "$ref": "#/components/schemas/PostCategoryRef" },
          "author": { "$ref": "#/components/schemas/PostAuthorRef" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TagRef" }
          }
        }
      },
      "PublicPost": {
        "allOf": [
          { "$ref": "#/components/schemas/Post" },
          {
            "type": "object",
            "properties": {
              "author": { "$ref": "#/components/schemas/PublicPostAuthorRef" }
            }
          }
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "AdminCompany": {
        "allOf": [
          { "$ref": "#/components/schemas/Company" },
          {
            "type": "object",
            "properties": {
              "_count": {
                "type": "object",
                "properties": {
                  "users": { "type": "integer" },
                  "posts": { "type": "integer" }
                }
              }
            }
          }
        ]
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "companyId": { "type": "integer", "nullable": true },
          "company": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "slug": { "type": "string" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AdminPost": {
        "allOf": [
          { "$ref": "#/components/schemas/Post" },
          {
            "type": "object",
            "properties": {
              "company": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer" },
                  "name": { "type": "string" },
                  "slug": { "type": "string" }
                }
              }
            }
          }
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud invalida.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Unauthorized": {
        "description": "Falta token o token invalido/expirado.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Forbidden": {
        "description": "El usuario autenticado no tiene permisos para esta accion (por ejemplo, no es super_admin, o es un super_admin sin empresa intentando usar un endpoint de tenant).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "NotFound": {
        "description": "Recurso no encontrado.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Conflict": {
        "description": "Conflicto (recurso ya existente).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "TooManyRequests": {
        "description": "Limite de solicitudes excedido.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Estado del servicio",
        "responses": {
          "200": {
            "description": "El servicio esta activo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar un usuario dentro de una empresa existente",
        "description": "Limitado a 10 intentos cada 15 minutos por IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name", "companyId"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password", "minLength": 8 },
                  "name": { "type": "string" },
                  "companyId": { "type": "integer" }
                }
              },
              "example": { "email": "ada@acme.com", "password": "supersecret123", "name": "Ada Lovelace", "companyId": 1 }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesion",
        "description": "Limitado a 10 intentos cada 15 minutos por IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              },
              "example": { "email": "ada@acme.com", "password": "supersecret123" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/AuthLoginResponseData" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/companies": {
      "post": {
        "tags": ["Companies"],
        "summary": "Crear una empresa (requiere super admin)",
        "description": "Restringido a usuarios con role=super_admin. Crea tambien un CompanySettings por defecto.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "slug": { "type": "string", "description": "Opcional. Si se omite, se genera a partir de name." }
                }
              },
              "example": { "name": "Acme Inc" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Empresa creada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Company" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/companies/me": {
      "get": {
        "tags": ["Companies"],
        "summary": "Obtener la empresa autenticada",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Empresa encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Company" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Companies"],
        "summary": "Actualizar la empresa autenticada",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "name": { "type": "string" } }
              },
              "example": { "name": "Acme Incorporated" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Empresa actualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Company" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/companies/me/settings": {
      "get": {
        "tags": ["Companies"],
        "summary": "Obtener la configuracion de la empresa autenticada",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Configuracion encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/CompanySettings" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Companies"],
        "summary": "Actualizar la configuracion de la empresa autenticada",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "allowedOrigins": { "type": "array", "items": { "type": "string" } },
                  "defaultPostStatus": { "$ref": "#/components/schemas/PostStatus" }
                }
              },
              "example": { "defaultPostStatus": "pending" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuracion actualizada (se crea si no existia).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/CompanySettings" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "Listar posts de la empresa autenticada",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de posts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Posts"],
        "summary": "Crear un post",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "body", "categoryId"],
                "properties": {
                  "title": { "type": "string" },
                  "cover": { "type": "string", "description": "URL ya alojada (alternativa a subir un archivo)." },
                  "body": { "type": "string" },
                  "categoryId": { "type": "integer" },
                  "tagIds": { "type": "array", "items": { "type": "integer" } },
                  "status": { "$ref": "#/components/schemas/PostStatus" }
                }
              },
              "example": { "title": "Hola mundo", "body": "Contenido del post...", "categoryId": 1, "tagIds": [1, 2] }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["title", "body", "categoryId"],
                "properties": {
                  "title": { "type": "string" },
                  "cover": { "type": "string", "format": "binary", "description": "Imagen de portada (jpeg/png/webp, max 5MB)." },
                  "body": { "type": "string" },
                  "categoryId": { "type": "integer" },
                  "tagIds": { "type": "string", "description": "Array de ids en JSON, ej. \"[1,2]\"." },
                  "status": { "$ref": "#/components/schemas/PostStatus" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post creado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Post" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/posts/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
      ],
      "get": {
        "tags": ["Posts"],
        "summary": "Obtener un post por id",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Post encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Post" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Posts"],
        "summary": "Actualizar un post",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "cover": { "type": "string", "description": "URL ya alojada (alternativa a subir un archivo)." },
                  "body": { "type": "string" },
                  "categoryId": { "type": "integer" },
                  "tagIds": { "type": "array", "items": { "type": "integer" } },
                  "status": { "$ref": "#/components/schemas/PostStatus" }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "cover": { "type": "string", "format": "binary", "description": "Imagen de portada (jpeg/png/webp, max 5MB). Reemplaza la anterior." },
                  "body": { "type": "string" },
                  "categoryId": { "type": "integer" },
                  "tagIds": { "type": "string", "description": "Array de ids en JSON, ej. \"[1,2]\"." },
                  "status": { "$ref": "#/components/schemas/PostStatus" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Post" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Posts"],
        "summary": "Eliminar un post",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Post eliminado.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiMessage" } } }
          },
